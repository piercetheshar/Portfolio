# Google Gemini API Key (100% Free Option - Recommended)
# Get your free key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API Key (Optional alternative)
# Get your key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Allowed CORS Origins (Optional - comma-separated for multiple domains)
# Example: https://sharvarimayekar.com, https://sharvari-portfolio.vercel.app
# Leave blank during local testing to allow localhost requests
ALLOWED_ORIGIN=
